/* QFluentPlus MathPlotToolbar - Light Theme */

MathPlotToolbar {
    background-color: transparent;
    border: none;
}

MathPlotToolbar QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}

MathPlotToolbar QToolButton:hover {
    background-color: #f0f0f0;
}

MathPlotToolbar QToolButton:pressed {
    background-color: #e0e0e0;
}

MathPlotToolbar QToolButton:checked {
    background-color: #0078d4;
    color: white;
}
