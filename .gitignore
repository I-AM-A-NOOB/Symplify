# Python related files
__pycache__
/.venv
# IDE related files
/.idea
/.vscode
# Distribution files
/main.build
/main.dist
/build
# Nuitka's diagnostics, written next to the CWD when a build fails
nuitka-crash-report.xml
nuitka_output.txt
# Portable-mode marker: its presence makes the app read/write data/config.yaml
# instead of the system config directory (see python/settings.py)
/data
# Generated docs export (architecture.md -> html, local preview tooling)
/docs/architecture.html
/docs/architecture_files/

# Icon rasters, written from icon/Symplify.svg by icon/build-icons.ps1. The .ico
# is committed because Nuitka embeds it; these loose PNGs are derived from the
# same SVG by a committed script, and nothing reads them.
/icons-png/

# Old files
*.old
*.old.py
# Local reference screenshots (not part of the source or docs)
/screenshoots/
